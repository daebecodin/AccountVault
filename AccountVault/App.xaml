<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AccountVault.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Console Dark is the startup color scheme. -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0C0F0D" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#151A17" />
            <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#1C241F" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#56D364" />
            <SolidColorBrush x:Key="AppTextBrush" Color="#E6EDF3" />
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#8B949E" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#30363D" />

            <Style x:Key="ToolbarComboBoxStyle" TargetType="ComboBox">
                <Setter Property="MinWidth" Value="140" />
                <Setter Property="Height" Value="42" />
            </Style>

            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
