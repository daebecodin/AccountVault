<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AccountVault.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Console Dark is the startup color scheme. -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0C0F0D" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#151A17" />
            <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#1C241F" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#56D364" />
            <SolidColorBrush x:Key="AppAccentLowBrush" Color="#2056D364" />
            <SolidColorBrush x:Key="AppAccentMediumBrush" Color="#4056D364" />
            <!-- Hover and pressed tones blend toward the background, so
                 accent-filled commands darken instead of flashing brighter. -->
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#4AB757" />
            <SolidColorBrush x:Key="AppAccentPressedBrush" Color="#3E9949" />
            <SolidColorBrush x:Key="AppTextBrush" Color="#E6EDF3" />
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#8B949E" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#30363D" />

            <!-- WinUI's AccentButtonStyle supplies the native interaction
                 animation; these mutable tokens keep it on the app theme. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#56D364" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#4AB757" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#3E9949" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#56D364" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#4AB757" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#3E9949" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#0C0F0D" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0C0F0D" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#0C0F0D" />

            <Style x:Key="ToolbarComboBoxStyle" TargetType="ComboBox">
                <Setter Property="MinWidth" Value="140" />
                <Setter Property="Height" Value="42" />
            </Style>

            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>

            <Style
                x:Key="PrimaryActionButtonStyle"
                TargetType="Button"
                BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
