<Window
    x:Class="AccountVault.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AccountVault"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Account Armory">

    <Grid x:ConnectionId='2'
        x:Name="AdaptiveHost"
        Background="{StaticResource AppBackgroundBrush}"
        AutomationProperties.Name="Account Armory main window">
        <Grid.Resources>
            <!--
                Rail actions stay transparent at rest. Hover and pressed states
                reference AppAccentBrush, which ThemeService updates in place.
            -->
            <Style x:Key="ActionRailButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
                <Setter Property="FontFamily" Value="Cascadia Mono" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Border
                                    x:Name="HoverFill"
                                    Background="{StaticResource AppAccentBrush}"
                                    CornerRadius="4"
                                    Opacity="0" />

                                <Border
                                    x:Name="AccentIndicator"
                                    Width="2"
                                    Margin="0,5,0,5"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource AppAccentBrush}"
                                    CornerRadius="1"
                                    Opacity="0" />

                                <Border
                                    x:Name="FocusStroke"
                                    BorderBrush="{StaticResource AppAccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Opacity="0" />

                                <ContentPresenter
                                    x:Name="ButtonContent"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Foreground="{TemplateBinding Foreground}" />

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition To="Normal" GeneratedDuration="0:0:0.12" />
                                            <VisualTransition To="PointerOver" GeneratedDuration="0:0:0.12" />
                                            <VisualTransition To="Pressed" GeneratedDuration="0:0:0.06" />
                                        </VisualStateGroup.Transitions>

                                        <VisualState x:Name="Normal" />

                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="HoverFill.Opacity" Value="0.10" />
                                                <Setter Target="AccentIndicator.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="HoverFill.Opacity" Value="0.18" />
                                                <Setter Target="AccentIndicator.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ButtonContent.Opacity" Value="0.40" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>

                                    <VisualStateGroup x:Name="FocusStates">
                                        <VisualState x:Name="Unfocused" />
                                        <VisualState x:Name="PointerFocused" />
                                        <VisualState x:Name="Focused">
                                            <VisualState.Setters>
                                                <Setter Target="FocusStroke.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="WorkspaceNavToggleStyle" TargetType="ToggleButton">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
                <Setter Property="FontFamily" Value="Cascadia Mono" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid Background="Transparent">
                                <Border
                                    x:Name="SelectionFill"
                                    Background="{StaticResource AppAccentBrush}"
                                    CornerRadius="5"
                                    Opacity="0" />
                                <Border
                                    x:Name="SelectionIndicator"
                                    Width="3"
                                    Margin="0,6,0,6"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource AppAccentBrush}"
                                    CornerRadius="2"
                                    Opacity="0" />
                                <ContentPresenter
                                    x:Name="NavContent"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="SelectionFill.Opacity" Value="0.08" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="SelectionFill.Opacity" Value="0.16" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="NavContent.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="SelectionFill.Opacity" Value="0.12" />
                                                <Setter Target="SelectionIndicator.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Shared presentation for independent live status items. -->
            <Style x:Key="StatusMetricTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="Foreground" Value="{StaticResource AppAccentBrush}" />
            </Style>
        </Grid.Resources>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:ConnectionId='32' x:Name="WindowWidthStates">
                <!--
                    MainWindow.xaml.cpp activates exactly one StateTrigger from
                    the measured AdaptiveHost width. This avoids relying on a
                    Window-root AdaptiveTrigger to discover the active bounds.
                -->
                <VisualState x:ConnectionId='33' x:Name="WideShell">
                    <VisualState.StateTriggers>
                        <StateTrigger x:ConnectionId='38' x:Name="WideShellTrigger" IsActive="False" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellFrame.Margin" Value="24" />
                        <Setter Target="RootGrid.Padding" Value="0" />
                        <Setter Target="RootGrid.ColumnSpacing" Value="20" />
                        <Setter Target="LeftRailColumn.Width" Value="220" />
                        <Setter Target="RightRailColumn.Width" Value="240" />
                        <Setter Target="LeftRail.Visibility" Value="Visible" />
                        <Setter Target="RightRail.Visibility" Value="Visible" />
                        <Setter Target="CompactNavigation.CompactPaneLength" Value="0" />
                        <Setter Target="CompactNavigation.IsPaneToggleButtonVisible" Value="False" />
                        <Setter Target="AccountActionsButton.Visibility" Value="Collapsed" />
                        <Setter Target="HeaderTitle.FontSize" Value="30" />
                        <Setter Target="HeaderSubtitle.Visibility" Value="Visible" />

                        <Setter Target="ToolbarGrid.Margin" Value="0,28,0,22" />
                        <Setter Target="ToolbarColumn0.Width" Value="*" />
                        <Setter Target="ToolbarColumn1.Width" Value="Auto" />
                        <Setter Target="ToolbarColumn2.Width" Value="Auto" />
                        <Setter Target="ToolbarColumn3.Width" Value="Auto" />
                        <Setter Target="TopAddAccountButton.Visibility" Value="Visible" />
                        <Setter Target="TopMoreActionsButton.Visibility" Value="Visible" />
                        <Setter Target="SearchBox.(Grid.Row)" Value="0" />
                        <Setter Target="SearchBox.(Grid.Column)" Value="0" />
                        <Setter Target="SearchBox.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="RecordFilter.(Grid.Row)" Value="0" />
                        <Setter Target="RecordFilter.(Grid.Column)" Value="1" />
                        <Setter Target="RecordFilter.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="RecordFilter.MinWidth" Value="145" />

                        <Setter Target="StatusSizeColumn.Width" Value="Auto" />
                        <Setter Target="StatusDividerColumn.Width" Value="Auto" />
                        <Setter Target="StatusTimerColumn.Width" Value="Auto" />
                        <Setter Target="WindowSizeText.(Grid.Row)" Value="0" />
                        <Setter Target="WindowSizeText.(Grid.Column)" Value="1" />
                        <Setter Target="WindowSizeText.Margin" Value="0" />
                        <Setter Target="WindowSizeText.MinWidth" Value="0" />
                        <Setter Target="WindowSizeText.TextAlignment" Value="Right" />
                        <Setter Target="StatusDividerText.(Grid.Row)" Value="0" />
                        <Setter Target="StatusDividerText.(Grid.Column)" Value="2" />
                        <Setter Target="StatusDividerText.Visibility" Value="Visible" />
                        <Setter Target="AutoLockStatusText.(Grid.Row)" Value="0" />
                        <Setter Target="AutoLockStatusText.(Grid.Column)" Value="3" />
                        <Setter Target="AutoLockStatusText.Margin" Value="0" />
                        <Setter Target="AutoLockStatusText.MinWidth" Value="0" />
                        <Setter Target="AutoLockStatusText.TextAlignment" Value="Left" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:ConnectionId='34' x:Name="CenterOnlyShell">
                    <VisualState.StateTriggers>
                        <StateTrigger x:ConnectionId='37' x:Name="CenterOnlyShellTrigger" IsActive="False" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellFrame.Margin" Value="18" />
                        <Setter Target="RootGrid.Padding" Value="0" />
                        <Setter Target="RootGrid.ColumnSpacing" Value="0" />
                        <Setter Target="LeftRailColumn.Width" Value="0" />
                        <Setter Target="RightRailColumn.Width" Value="0" />
                        <Setter Target="LeftRail.Visibility" Value="Collapsed" />
                        <Setter Target="RightRail.Visibility" Value="Collapsed" />
                        <Setter Target="CompactNavigation.CompactPaneLength" Value="48" />
                        <Setter Target="CompactNavigation.IsPaneToggleButtonVisible" Value="True" />
                        <Setter Target="AccountActionsButton.Visibility" Value="Visible" />
                        <Setter Target="AccountActionsButton.Content" Value="ACCOUNT ACTIONS" />
                        <Setter Target="AccountActionsButton.Padding" Value="18,10" />
                        <Setter Target="HeaderTitle.FontSize" Value="30" />
                        <Setter Target="HeaderSubtitle.Visibility" Value="Visible" />

                        <Setter Target="ToolbarGrid.Margin" Value="0,28,0,22" />
                        <Setter Target="ToolbarColumn0.Width" Value="*" />
                        <Setter Target="ToolbarColumn1.Width" Value="Auto" />
                        <Setter Target="ToolbarColumn2.Width" Value="0" />
                        <Setter Target="ToolbarColumn3.Width" Value="0" />
                        <Setter Target="TopAddAccountButton.Visibility" Value="Collapsed" />
                        <Setter Target="TopMoreActionsButton.Visibility" Value="Collapsed" />
                        <Setter Target="SearchBox.(Grid.Row)" Value="0" />
                        <Setter Target="SearchBox.(Grid.Column)" Value="0" />
                        <Setter Target="SearchBox.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="RecordFilter.(Grid.Row)" Value="0" />
                        <Setter Target="RecordFilter.(Grid.Column)" Value="1" />
                        <Setter Target="RecordFilter.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="RecordFilter.MinWidth" Value="145" />

                        <Setter Target="StatusSizeColumn.Width" Value="Auto" />
                        <Setter Target="StatusDividerColumn.Width" Value="Auto" />
                        <Setter Target="StatusTimerColumn.Width" Value="Auto" />
                        <Setter Target="WindowSizeText.(Grid.Row)" Value="0" />
                        <Setter Target="WindowSizeText.(Grid.Column)" Value="1" />
                        <Setter Target="WindowSizeText.Margin" Value="0" />
                        <Setter Target="WindowSizeText.MinWidth" Value="0" />
                        <Setter Target="WindowSizeText.TextAlignment" Value="Right" />
                        <Setter Target="StatusDividerText.(Grid.Row)" Value="0" />
                        <Setter Target="StatusDividerText.(Grid.Column)" Value="2" />
                        <Setter Target="StatusDividerText.Visibility" Value="Visible" />
                        <Setter Target="AutoLockStatusText.(Grid.Row)" Value="0" />
                        <Setter Target="AutoLockStatusText.(Grid.Column)" Value="3" />
                        <Setter Target="AutoLockStatusText.Margin" Value="0" />
                        <Setter Target="AutoLockStatusText.MinWidth" Value="0" />
                        <Setter Target="AutoLockStatusText.TextAlignment" Value="Left" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:ConnectionId='35' x:Name="CompactShell">
                    <VisualState.StateTriggers>
                        <StateTrigger x:ConnectionId='36' x:Name="CompactShellTrigger" IsActive="False" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellFrame.Margin" Value="12" />
                        <Setter Target="RootGrid.Padding" Value="0" />
                        <Setter Target="RootGrid.ColumnSpacing" Value="0" />
                        <Setter Target="LeftRailColumn.Width" Value="0" />
                        <Setter Target="RightRailColumn.Width" Value="0" />
                        <Setter Target="LeftRail.Visibility" Value="Collapsed" />
                        <Setter Target="RightRail.Visibility" Value="Collapsed" />
                        <Setter Target="CompactNavigation.CompactPaneLength" Value="48" />
                        <Setter Target="CompactNavigation.IsPaneToggleButtonVisible" Value="True" />
                        <Setter Target="AccountActionsButton.Visibility" Value="Visible" />
                        <Setter Target="AccountActionsButton.Content" Value="ACTIONS" />
                        <Setter Target="AccountActionsButton.Padding" Value="12,10" />
                        <Setter Target="HeaderTitle.FontSize" Value="26" />
                        <Setter Target="HeaderSubtitle.Visibility" Value="Collapsed" />

                        <Setter Target="ToolbarGrid.Margin" Value="0,20,0,18" />
                        <Setter Target="ToolbarColumn0.Width" Value="*" />
                        <Setter Target="ToolbarColumn1.Width" Value="0" />
                        <Setter Target="ToolbarColumn2.Width" Value="0" />
                        <Setter Target="ToolbarColumn3.Width" Value="0" />
                        <Setter Target="TopAddAccountButton.Visibility" Value="Collapsed" />
                        <Setter Target="TopMoreActionsButton.Visibility" Value="Collapsed" />
                        <Setter Target="SearchBox.(Grid.Row)" Value="0" />
                        <Setter Target="SearchBox.(Grid.Column)" Value="0" />
                        <Setter Target="SearchBox.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="RecordFilter.(Grid.Row)" Value="1" />
                        <Setter Target="RecordFilter.(Grid.Column)" Value="0" />
                        <Setter Target="RecordFilter.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="RecordFilter.MinWidth" Value="0" />

                        <Setter Target="StatusSizeColumn.Width" Value="0" />
                        <Setter Target="StatusDividerColumn.Width" Value="0" />
                        <Setter Target="StatusTimerColumn.Width" Value="0" />
                        <Setter Target="WindowSizeText.(Grid.Row)" Value="1" />
                        <Setter Target="WindowSizeText.(Grid.Column)" Value="0" />
                        <Setter Target="WindowSizeText.Margin" Value="0,4,0,0" />
                        <Setter Target="WindowSizeText.MinWidth" Value="0" />
                        <Setter Target="WindowSizeText.TextAlignment" Value="Left" />
                        <Setter Target="StatusDividerText.Visibility" Value="Collapsed" />
                        <Setter Target="AutoLockStatusText.(Grid.Row)" Value="2" />
                        <Setter Target="AutoLockStatusText.(Grid.Column)" Value="0" />
                        <Setter Target="AutoLockStatusText.Margin" Value="0,4,0,0" />
                        <Setter Target="AutoLockStatusText.MinWidth" Value="0" />
                        <Setter Target="AutoLockStatusText.TextAlignment" Value="Left" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!--
            Outer shell owns the responsive window margin and maximum content
            width. The three-column RootGrid can then use the full shell width,
            allowing both rails to remain substantial on ultrawide displays.
        -->
        <Border x:ConnectionId='39'
            x:Name="ShellFrame"
            MaxWidth="2240"
            Margin="24"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <Grid x:ConnectionId='40'
                x:Name="RootGrid"
                Padding="0"
                ColumnSpacing="20"
                RowSpacing="14"
                HorizontalAlignment="Stretch">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:ConnectionId='41' x:Name="LeftRailColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:ConnectionId='42' x:Name="RightRailColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Container 1: wide-window workspace navigation. -->
            <Border x:ConnectionId='43'
                x:Name="LeftRail"
                Padding="14,16"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed"
                AutomationProperties.Name="Navigation">
                <StackPanel Spacing="5">
                    <TextBlock
                        Margin="10,0,0,10"
                        Text="NAVIGATION"
                        FontFamily="Cascadia Mono"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AppAccentBrush}" />

                    <ToggleButton x:ConnectionId='110'
                        x:Name="LauncherWorkspaceButton"
                        IsChecked="True"
                        Style="{StaticResource WorkspaceNavToggleStyle}"
                        AutomationProperties.Name="Launcher Vault workspace"
                                                             >
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7FC;" />
                            <TextBlock Text="Launcher Vault" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:ConnectionId='111'
                        x:Name="CredentialWorkspaceButton"
                        Style="{StaticResource WorkspaceNavToggleStyle}"
                        AutomationProperties.Name="Credential Vault workspace"
                                                               >
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF540;" />
                            <TextBlock Text="Credential Vault" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Border>

            <!--
                Container 2: account workspace hosted by WinUI NavigationView.
                Below the wide-shell breakpoint, LeftCompact keeps a slim icon
                rail visible and opens its pane over the account workspace.
            -->
            <NavigationView x:ConnectionId='44'
                x:Name="CompactNavigation"
                Grid.Column="1"
                PaneDisplayMode="LeftCompact"
                OpenPaneLength="288"
                CompactPaneLength="48"
                IsPaneOpen="False"
                IsPaneToggleButtonVisible="True"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False"
                AlwaysShowHeader="False"
                Background="{StaticResource AppBackgroundBrush}"
                                                                       
                AutomationProperties.Name="Navigation drawer">
                <!--
                    WinUI defaults this internal content surface to 8,0,0,0
                    for left navigation. Override the template resource locally
                    so the visible outer workspace has four matching corners.
                -->
                <NavigationView.Resources>
                    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">10,10,10,10</CornerRadius>
                    <StaticResource
                        x:Key="NavigationViewContentBackground"
                        ResourceKey="AppBackgroundBrush" />
                    <StaticResource
                        x:Key="NavigationViewSelectionIndicatorForeground"
                        ResourceKey="AppAccentBrush" />
                    <StaticResource
                        x:Key="NavigationViewItemBackground"
                        ResourceKey="AppBackgroundBrush" />
                    <StaticResource
                        x:Key="NavigationViewItemBackgroundPointerOver"
                        ResourceKey="AppAccentLowBrush" />
                    <StaticResource
                        x:Key="NavigationViewItemBackgroundPressed"
                        ResourceKey="AppAccentMediumBrush" />
                    <StaticResource
                        x:Key="NavigationViewItemBackgroundSelected"
                        ResourceKey="AppAccentLowBrush" />
                    <StaticResource
                        x:Key="NavigationViewItemBackgroundSelectedPointerOver"
                        ResourceKey="AppAccentMediumBrush" />
                    <StaticResource
                        x:Key="NavigationViewItemBackgroundSelectedPressed"
                        ResourceKey="AppAccentMediumBrush" />
                    <StaticResource
                        x:Key="NavigationViewItemForeground"
                        ResourceKey="AppTextBrush" />
                    <StaticResource
                        x:Key="NavigationViewItemForegroundPointerOver"
                        ResourceKey="AppTextBrush" />
                    <StaticResource
                        x:Key="NavigationViewItemForegroundSelected"
                        ResourceKey="AppTextBrush" />
                    <StaticResource
                        x:Key="NavigationViewItemForegroundSelectedPointerOver"
                        ResourceKey="AppTextBrush" />
                </NavigationView.Resources>

                <NavigationView.MenuItems>
                    <NavigationViewItem x:ConnectionId='71'
                        x:Name="LauncherNavigationItem"
                        Content="Launcher Vault"
                        Tag="launcher"
                        IsSelected="True">
                        <NavigationViewItem.Icon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7FC;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:ConnectionId='72'
                        x:Name="CredentialNavigationItem"
                        Content="Credential Vault"
                        Tag="credential">
                        <NavigationViewItem.Icon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF540;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <Border x:ConnectionId='73'
                    x:Name="AccountWorkspace"
                    Margin="12"
                    Padding="18"
                    Background="{StaticResource AppBackgroundBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10,10,10,10"
                    AutomationProperties.Name="Account workspace">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid x:ConnectionId='74' x:Name="HeaderGrid" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="ACCOUNT ARMORY"
                                FontFamily="Cascadia Mono"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource AppAccentBrush}" />
                            <TextBlock x:ConnectionId='108'
                                x:Name="HeaderTitle"
                                Text="Launcher Vault"
                                FontSize="30"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource AppTextBrush}" />
                            <TextBlock x:ConnectionId='109'
                                x:Name="HeaderSubtitle"
                                Text="Manage linked launcher and email credentials in one record."
                                TextWrapping="Wrap"
                                Foreground="{StaticResource AppMutedTextBrush}" />
                        </StackPanel>

                        <!-- Compact/center-only replacement for the right rail. -->
                        <DropDownButton x:ConnectionId='91'
                            x:Name="AccountActionsButton"
                            Grid.Column="1"
                            Content="ACCOUNT ACTIONS"
                            Padding="18,10"
                            VerticalAlignment="Center"
                            AccessKey="A"
                            AutomationProperties.Name="Account actions and tools"
                            AutomationProperties.HelpText="Add, import, export, change appearance, or open utilities">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:ConnectionId='92' x:Name="CompactAddMenuItem" Text="Add account"                                />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:ConnectionId='93' x:Name="CompactImportOneMenuItem" Text="Import one account..."                                      />
                                    <MenuFlyoutItem x:ConnectionId='94' x:Name="CompactImportAllMenuItem" Text="Import all accounts..."                                       />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:ConnectionId='95' x:Name="CompactExportAllMenuItem" Text="Export all accounts..."                                       />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutSubItem Text="Theme">
                                        <MenuFlyoutItem x:ConnectionId='98' Text="Catppuccin Mocha" Tag="0"                                    />
                                        <MenuFlyoutItem x:ConnectionId='99' Text="Tokyo Night" Tag="1"                                    />
                                        <MenuFlyoutItem x:ConnectionId='100' Text="Dracula" Tag="2"                                    />
                                        <MenuFlyoutItem x:ConnectionId='101' Text="Ayu Mirage" Tag="3"                                    />
                                        <MenuFlyoutItem x:ConnectionId='102' Text="Dainty Dark" Tag="4"                                    />
                                        <MenuFlyoutItem x:ConnectionId='103' Text="GitHub Dark" Tag="5"                                    />
                                        <MenuFlyoutItem x:ConnectionId='104' Text="Atom One Dark" Tag="6"                                    />
                                        <MenuFlyoutItem x:ConnectionId='105' Text="Houston" Tag="7"                                    />
                                        <MenuFlyoutItem x:ConnectionId='106' Text="Night Owl" Tag="8"                                    />
                                        <MenuFlyoutItem x:ConnectionId='107' Text="Matcha" Tag="9"                                    />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutItem x:ConnectionId='96' Text="Customize colors..."                                     />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:ConnectionId='97' Text="Password generator..."                                       />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>

                    <Grid x:ConnectionId='75'
                        x:Name="ToolbarGrid"
                        Grid.Row="1"
                        Margin="0,28,0,22"
                        ColumnSpacing="12"
                        RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:ConnectionId='80' x:Name="ToolbarColumn0" Width="*" />
                            <ColumnDefinition x:ConnectionId='81' x:Name="ToolbarColumn1" Width="Auto" />
                            <ColumnDefinition x:ConnectionId='82' x:Name="ToolbarColumn2" Width="Auto" />
                            <ColumnDefinition x:ConnectionId='83' x:Name="ToolbarColumn3" Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:ConnectionId='84'
                            x:Name="SearchBox"
                            Height="44"
                            AccessKey="S"
                            AutomationProperties.Name="Search accounts"
                            AutomationProperties.HelpText="Search by launcher, username, email, or provider website"
                            PlaceholderText="Search launcher, username, email, or provider website"
                                                                />

                        <ComboBox x:ConnectionId='85'
                            x:Name="RecordFilter"
                            Grid.Column="1"
                            MinWidth="145"
                            AccessKey="L"
                            AutomationProperties.Name="Record filter"
                            Style="{StaticResource ToolbarComboBoxStyle}"
                            SelectedIndex="0"
                                                                            >
                            <ComboBoxItem Content="All launchers" />
                            <ComboBoxItem Content="Steam" />
                            <ComboBoxItem Content="Riot" />
                            <ComboBoxItem Content="Epic" />
                            <ComboBoxItem Content="Other" />
                        </ComboBox>

                        <Button x:ConnectionId='86'
                            x:Name="TopAddAccountButton"
                            Grid.Column="2"
                            Content="Add account"
                            Height="44"
                            Padding="18,0"
                            Visibility="Collapsed"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            AccessKey="A"
                            AutomationProperties.Name="Add account"
                                                           />

                        <DropDownButton x:ConnectionId='87'
                            x:Name="TopMoreActionsButton"
                            Grid.Column="3"
                            Content="MORE"
                            Height="44"
                            Padding="16,0"
                            Visibility="Collapsed"
                            AccessKey="M"
                            AutomationProperties.Name="More account actions"
                            AutomationProperties.HelpText="Import or export accounts">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:ConnectionId='88' x:Name="TopImportOneMenuItem" Text="Import one account..."                                      />
                                    <MenuFlyoutItem x:ConnectionId='89' x:Name="TopImportAllMenuItem" Text="Import all accounts..."                                       />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:ConnectionId='90' x:Name="TopExportAllMenuItem" Text="Export all accounts..."                                       />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListView x:ConnectionId='76'
                            x:Name="AccountsList"
                            SelectionMode="None"
                            AutomationProperties.Name="Accounts"
                            AutomationProperties.HelpText="Stored launcher and email accounts"
                            Background="Transparent"
                            HorizontalContentAlignment="Stretch"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <StackPanel x:ConnectionId='77'
                            x:Name="EmptyState"
                            MaxWidth="360"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <TextBlock x:ConnectionId='78'
                                x:Name="EmptyStateTitle"
                                Text="No accounts found"
                                FontSize="20"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource AppTextBrush}" />
                            <TextBlock x:ConnectionId='79'
                                x:Name="EmptyStateSubtitle"
                                Text="Add an account or change your search."
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource AppMutedTextBrush}" />
                        </StackPanel>
                    </Grid>
                    </Grid>
                </Border>
            </NavigationView>

            <!-- Container 3: status spans the full shell below all columns. -->
            <Border x:ConnectionId='45'
                x:Name="StatusContainer"
                Grid.Row="1"
                Grid.ColumnSpan="3"
                Padding="12,8"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                AutomationProperties.Name="Application status bar">
                <Grid x:ConnectionId='63' x:Name="StatusGrid" ColumnSpacing="0" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:ConnectionId='64' x:Name="StatusSizeColumn" Width="Auto" />
                        <ColumnDefinition x:ConnectionId='65' x:Name="StatusDividerColumn" Width="Auto" />
                        <ColumnDefinition x:ConnectionId='66' x:Name="StatusTimerColumn" Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:ConnectionId='67'
                        x:Name="StatusText"
                        Text="Passwords are encrypted locally with Windows DPAPI."
                        AutomationProperties.Name="Application status"
                        AutomationProperties.LiveSetting="Polite"
                        FontFamily="Cascadia Mono"
                        FontSize="12"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource AppMutedTextBrush}" />

                    <TextBlock x:ConnectionId='68'
                        x:Name="WindowSizeText"
                        Grid.Column="1"
                        Text="0 x 0"
                        AutomationProperties.Name="Current application width and height"
                        Style="{StaticResource StatusMetricTextStyle}"
                        TextAlignment="Right" />

                    <TextBlock x:ConnectionId='69'
                        x:Name="StatusDividerText"
                        Grid.Column="2"
                        Margin="12,0"
                        Text="|"
                        FontFamily="Cascadia Mono"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource AppMutedTextBrush}" />

                    <TextBlock x:ConnectionId='70'
                        x:Name="AutoLockStatusText"
                        Grid.Column="3"
                        Text="AUTO-LOCK 05:00"
                        AutomationProperties.Name="Automatic lock countdown"
                        Style="{StaticResource StatusMetricTextStyle}"
                        TextAlignment="Left" />
                </Grid>
            </Border>

            <!-- Container 4: wide-window appearance and utility tools. -->
            <Border x:ConnectionId='46'
                x:Name="RightRail"
                Grid.Column="2"
                Padding="14,16"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed"
                AutomationProperties.Name="Tools">
                <StackPanel Spacing="3">
                    <TextBlock x:ConnectionId='49'
                        x:Name="RightRailHeader"
                        Margin="10,0,0,10"
                        Text="TOOLS"
                        FontFamily="Cascadia Mono"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AppAccentBrush}" />

                    <TextBlock
                        Margin="10,0,0,8"
                        Text="APPEARANCE"
                        FontFamily="Cascadia Mono"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AppMutedTextBrush}" />

                    <ComboBox x:ConnectionId='50'
                        x:Name="ThemePicker"
                        Margin="0,0,0,4"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        AccessKey="T"
                        AutomationProperties.Name="Theme"
                        AutomationProperties.HelpText="Choose a theme; right-click the selected theme to change the startup theme"
                        Style="{StaticResource ToolbarComboBoxStyle}"
                        SelectedIndex="3"
                        ToolTipService.ToolTip="Right-click a theme to make it the startup theme"
                                                                       >
                        <ComboBoxItem x:ConnectionId='53' Content="Catppuccin Mocha"                                       />
                        <ComboBoxItem x:ConnectionId='54' Content="Tokyo Night"                                       />
                        <ComboBoxItem x:ConnectionId='55' Content="Dracula"                                       />
                        <ComboBoxItem x:ConnectionId='56' Content="Ayu Mirage"                                       />
                        <ComboBoxItem x:ConnectionId='57' Content="Dainty Dark"                                       />
                        <ComboBoxItem x:ConnectionId='58' Content="GitHub Dark"                                       />
                        <ComboBoxItem x:ConnectionId='59' Content="Atom One Dark"                                       />
                        <ComboBoxItem x:ConnectionId='60' Content="Houston"                                       />
                        <ComboBoxItem x:ConnectionId='61' Content="Night Owl"                                       />
                        <ComboBoxItem x:ConnectionId='62' Content="Matcha"                                       />
                    </ComboBox>

                    <Button x:ConnectionId='51'
                        x:Name="CustomizeColorsButton"
                        Content="Customize colors..."
                        Style="{StaticResource ActionRailButtonStyle}"
                        AccessKey="C"
                        AutomationProperties.Name="Customize colors"
                                                            />

                    <Border
                        Height="1"
                        Margin="10,16,10,12"
                        Background="{StaticResource AppBorderBrush}" />

                    <TextBlock
                        Margin="10,0,0,10"
                        Text="UTILITIES"
                        FontFamily="Cascadia Mono"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AppAccentBrush}" />

                    <Button x:ConnectionId='52'
                        Content="Password generator..."
                        Style="{StaticResource ActionRailButtonStyle}"
                        AccessKey="P"
                        AutomationProperties.Name="Open password generator"
                        AutomationProperties.HelpText="Generate and copy a cryptographically random password"
                                                              />
                </StackPanel>
            </Border>

            <Border x:ConnectionId='47'
                x:Name="LockOverlay"
                Grid.RowSpan="2"
                Grid.ColumnSpan="3"
                Canvas.ZIndex="1000"
                Padding="24"
                Background="{StaticResource AppBackgroundBrush}"
                AutomationProperties.Name="Account Armory locked"
                AutomationProperties.LiveSetting="Assertive"
                Visibility="Collapsed">
                <Border
                    MaxWidth="420"
                    Padding="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="14">
                        <TextBlock
                            Text="ACCOUNT ARMORY LOCKED"
                            TextAlignment="Center"
                            FontFamily="Cascadia Mono"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AppAccentBrush}" />
                        <TextBlock
                            Text="Your account information is hidden. Verify with Windows Hello to continue."
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource AppTextBrush}" />
                        <Button x:ConnectionId='48'
                            x:Name="UnlockButton"
                            Content="Unlock"
                            MinWidth="150"
                            Padding="18,10"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            HorizontalAlignment="Center"
                            AccessKey="U"
                            AutomationProperties.Name="Unlock Account Armory"
                                                       />
                    </StackPanel>
                </Border>
            </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

