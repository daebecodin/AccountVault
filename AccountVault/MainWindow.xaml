<Window
    x:Class="AccountVault.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AccountVault"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Account Armory">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid
            x:Name="RootGrid"
            MaxWidth="1560"
            Padding="36,32,36,24"
            HorizontalAlignment="Stretch">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    Text="ACCOUNT ARMORY"
                    FontFamily="Cascadia Mono"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource AppAccentBrush}" />
                <TextBlock
                    Text="Launcher accounts"
                    FontSize="30"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource AppTextBrush}" />
                <TextBlock
                    Text="Manage linked launcher and email credentials in one record."
                    Foreground="{StaticResource AppMutedTextBrush}" />
            </StackPanel>

            <DropDownButton
                x:Name="AccountActionsButton"
                Grid.Column="1"
                Content="ACCOUNT ACTIONS"
                Padding="18,10"
                VerticalAlignment="Center"
                AutomationProperties.Name="Account actions">
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Text="Add account"
                            Click="AddAccountButton_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            Text="Import one account..."
                            Click="ImportOneAccountButton_Click" />
                        <MenuFlyoutItem
                            Text="Import all accounts..."
                            Click="ImportAllAccountsButton_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            Text="Export all accounts..."
                            Click="ExportAllAccountsButton_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <Grid Grid.Row="1" Margin="0,28,0,22" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="SearchBox"
                Height="44"
                PlaceholderText="Search launcher, username, email, or provider website"
                TextChanged="SearchBox_TextChanged" />

            <ComboBox
                x:Name="LauncherFilter"
                Grid.Column="1"
                MinWidth="145"
                Style="{StaticResource ToolbarComboBoxStyle}"
                SelectedIndex="0"
                SelectionChanged="LauncherFilter_SelectionChanged">
                <ComboBoxItem Content="All launchers" />
                <ComboBoxItem Content="Steam" />
                <ComboBoxItem Content="Riot" />
                <ComboBoxItem Content="Epic" />
                <ComboBoxItem Content="Other" />
            </ComboBox>

            <ComboBox
                x:Name="ThemePicker"
                Grid.Column="2"
                MinWidth="150"
                Style="{StaticResource ToolbarComboBoxStyle}"
                SelectedIndex="3"
                ToolTipService.ToolTip="Right-click a theme to make it the startup theme"
                SelectionChanged="ThemePicker_SelectionChanged">
                <ComboBoxItem Content="Catppuccin Mocha" RightTapped="ThemeOption_RightTapped" />
                <ComboBoxItem Content="Tokyo Night" RightTapped="ThemeOption_RightTapped" />
                <ComboBoxItem Content="Dracula" RightTapped="ThemeOption_RightTapped" />
                <ComboBoxItem Content="Ayu Mirage" RightTapped="ThemeOption_RightTapped" />
                <ComboBoxItem Content="Dainty Dark" RightTapped="ThemeOption_RightTapped" />
                <ComboBoxItem Content="GitHub Dark" RightTapped="ThemeOption_RightTapped" />
                <ComboBoxItem Content="Atom One Dark" RightTapped="ThemeOption_RightTapped" />
                <ComboBoxItem Content="Houston" RightTapped="ThemeOption_RightTapped" />
                <ComboBoxItem Content="Night Owl" RightTapped="ThemeOption_RightTapped" />
                <ComboBoxItem Content="Matcha" RightTapped="ThemeOption_RightTapped" />
            </ComboBox>

            <Button
                Grid.Column="3"
                Content="Customize colors"
                Height="44"
                Padding="16,0"
                Click="CustomizeColorsButton_Click" />
        </Grid>

        <Grid Grid.Row="2">
            <ListView
                x:Name="AccountsList"
                SelectionMode="None"
                Background="Transparent"
                HorizontalContentAlignment="Stretch"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <TextBlock
                    Text="No accounts found"
                    FontSize="20"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Foreground="{StaticResource AppTextBrush}" />
                <TextBlock
                    Text="Add an account or change your search."
                    Foreground="{StaticResource AppMutedTextBrush}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,20,0,0" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="StatusText"
                Text="Passwords are encrypted locally with Windows DPAPI."
                FontFamily="Cascadia Mono"
                FontSize="12"
                TextTrimming="CharacterEllipsis"
                VerticalAlignment="Center"
                Foreground="{StaticResource AppMutedTextBrush}" />

            <TextBlock
                x:Name="AutoLockStatusText"
                Grid.Column="1"
                MinWidth="132"
                Text="AUTO-LOCK 05:00"
                TextAlignment="Right"
                FontFamily="Cascadia Mono"
                FontSize="12"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
                Foreground="{StaticResource AppAccentBrush}" />
        </Grid>

        <Border
            x:Name="LockOverlay"
            Grid.RowSpan="3"
            Canvas.ZIndex="1000"
            Padding="24"
            Background="{StaticResource AppBackgroundBrush}"
            Visibility="Collapsed">
            <Border
                MaxWidth="420"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppAccentBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="14">
                    <TextBlock
                        Text="ACCOUNT ARMORY LOCKED"
                        TextAlignment="Center"
                        FontFamily="Cascadia Mono"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AppAccentBrush}" />
                    <TextBlock
                        Text="Your account information is hidden. Verify with Windows Hello to continue."
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource AppTextBrush}" />
                    <Button
                        x:Name="UnlockButton"
                        Content="Unlock"
                        MinWidth="150"
                        Padding="18,10"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Unlock Account Armory"
                        Background="{StaticResource AppAccentBrush}"
                        Foreground="#0C0F0D"
                        Click="UnlockButton_Click" />
                </StackPanel>
            </Border>
        </Border>
        </Grid>
    </Grid>
</Window>
